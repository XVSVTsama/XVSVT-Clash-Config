# update-core.sh 的配置文件模板
#
# 用法：把本文件复制成同目录下的 update-core.conf，按需填写，然后在
# BoxProxy 的「工具 → 脚本」里直接运行 update-core.sh（不用带参数）。
# 命令行参数优先于这里的值。
#
# 注意：本文件会被脚本以 root 身份 source，只放变量赋值，不要放其它命令。

# 要替换哪个内核：ebpf → bin/core-ebpf，vanilla → bin/core-vanilla
CORE=ebpf

# 跟着仓库走：填 owner/repo，并给出资产名匹配规则（默认按 glob，* 与 ? 生效）
REPO=''
ASSET='*android-arm64*.gz'

# 版本策略：latest（最新稳定版）| prerelease（含预发布的最新）| tag（指定标签）
VERSION=latest
RELEASE_TAG=''

# 或者不用仓库，直接给固定地址（http(s):// 或 file://）；填了就优先用这个
URL=''

# 可选：下载文件的 SHA-256；仓库发布里带了 digest 时会自动使用，不用手填
SHA256=''

# 可选：新内核执行 -v 后，输出里必须包含的关键字（例如版本哈希）
TAG=''

# 可选：镜像。API_BASE 换成镜像的 API 前缀；DOWNLOAD_PREFIX 把下载地址改写为
# <前缀>/<原地址去掉 https://>
API_BASE=https://api.github.com
DOWNLOAD_PREFIX=''

# 可选：GitHub Token，提高 API 配额（等同账号凭据，不要提交到仓库）
TOKEN=''
