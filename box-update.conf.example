# ============================================================================
# box-update.conf —— 手动部分（update-core.sh）的配置
# ============================================================================
#
# 只有一件事必须填：内核从哪个仓库下载。
# 版本策略、资产名匹配、校验都有默认值，不写就用默认。
#
# 复制本文件为 box-update.conf，填仓库就行：

CORE_ebpf_REPO=''
CORE_vanilla_REPO=''

# ----------------------------------------------------------------------------
# 默认值（需要时再写，不写就等于注释里的值）
# ----------------------------------------------------------------------------
# ebpf 默认：VERSION='prerelease'  ASSET='*android-arm64*ebpf*.gz'
# vanilla 默认：VERSION='latest'   ASSET='*android-arm64*.gz'
# 其它名字默认：VERSION='latest'   ASSET='*android-arm64*.gz'
#
# CORE_ebpf_VERSION='prerelease'
# CORE_ebpf_ASSET='*android-arm64*ebpf*.gz'
# CORE_ebpf_TAG='-ebpf'              # -v 输出必须含这个串，防止下错文件
# CORE_ebpf_URL=''                   # 填了就不查仓库（固定版本/本地文件）
# CORE_ebpf_SHA256=''                # 仓库发布带 digest 时自动使用
#
# API_BASE='https://api.github.com'  # 直连困难时换成镜像的 API 地址
# DOWNLOAD_PREFIX=''                 # <前缀>/<原地址去掉 https://>
# TOKEN=''                           # GitHub Token，等同账号凭据，别提交
