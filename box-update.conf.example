# ============================================================================
# box-update.conf —— 手动部分（update-core.sh 等）的配置
# ============================================================================
#
# 这里只关心「内核从哪来」：仓库、资产名、版本策略、校验。
# 哪个入站用哪个内核、文件叫什么，在 box-auto.conf 里。
#
# 怎么用：
#   1. 把本文件复制成同目录下的 box-update.conf（去掉 .example 后缀）；
#   2. 给要用的内核填 REPO（其余有默认值，可以不动）；
#   3. 装/更新：sh update-core.sh --core ebpf
#
# 语法：KEY='值'，一行一个。只写变量赋值，不要写别的命令。
#
# ============================================================================
# 一、内核清单与来源
# ============================================================================
# 名字要和 box-auto.conf 的 CORE_LIST 对上。

CORE_LIST='ebpf vanilla'

# 不带 --core 时装哪个
CORE_DEFAULT='ebpf'

# 每个内核的字段：
#   _REPO         GitHub 仓库 owner/repo；与 _URL 二选一
#   _ASSET        资产名匹配（默认 glob，* 和 ? 生效）
#   _VERSION      latest（默认）| prerelease | tag
#   _RELEASE_TAG  VERSION=tag 时必填
#   _URL          固定下载地址；填了就不查仓库
#   _SHA256       手动校验值（仓库发布带 digest 时自动使用）
#   _TAG          新内核 -v 输出里必须包含的关键字
#   _FILE         只有文件名与自动部分不同才需要写

CORE_ebpf_REPO=''
CORE_ebpf_ASSET='*android-arm64*ebpf*.gz'
CORE_ebpf_VERSION='prerelease'
CORE_ebpf_RELEASE_TAG=''
CORE_ebpf_URL=''
CORE_ebpf_SHA256=''
CORE_ebpf_TAG=''

CORE_vanilla_REPO=''
CORE_vanilla_ASSET='*android-arm64*.gz'
CORE_vanilla_VERSION='latest'
CORE_vanilla_RELEASE_TAG=''
CORE_vanilla_URL=''
CORE_vanilla_SHA256=''
CORE_vanilla_TAG=''

# 加第三个内核：照抄一段改名，并把名字加进上面的 CORE_LIST。
# CORE_spare_REPO=''
# CORE_spare_ASSET='*android-arm64*.gz'
# CORE_spare_VERSION='tag'
# CORE_spare_RELEASE_TAG=''

# ============================================================================
# 二、下载相关
# ============================================================================

# GitHub API 前缀；直连困难时换成镜像的 API 地址
API_BASE='https://api.github.com'

# 下载地址改写前缀：<前缀>/<原地址去掉 https://>；留空表示不改写
DOWNLOAD_PREFIX=''

# GitHub Token，提高 API 配额、缓解 403 限流；等同账号凭据，不要提交
TOKEN=''
