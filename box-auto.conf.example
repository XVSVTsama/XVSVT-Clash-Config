# ============================================================================
# box-auto.conf —— 自动部分（iface-auto.sh）的配置
# ============================================================================
#
# 只有一件事非改不可的可能性：eBPF 模式想用别的内核。
# 其它全有默认值，不写就用默认。
#
# 默认行为：
#   ebpf 模式        → 内核 ebpf     → 文件 bin/core-ebpf
#   tun/tproxy/其它  → 内核 vanilla  → 文件 bin/core-vanilla
#
# 复制本文件为 box-auto.conf，改下面这一行就够：

MODE_CORE_ebpf='ebpf'

# ----------------------------------------------------------------------------
# 规则式选择（可选）：写了 RULES 就不再用上面的 MODE_CORE_* 映射
# ----------------------------------------------------------------------------
# 一行一条：条件 => 内核名[, 次选内核, ...]
# 从上往下求值，第一条命中的生效；命中后的候选内核按顺序试，第一个可用的胜出；
# 全部不可用 → 直接退出，不继续往下匹配。
#
# 判断项：mode=ebpf | js=ebpf-我的.js | conf~关键字 | tethering=on/off
#         installed=内核名 | exists=文件名 | env=NAME:值
# 组合：not / ! 、and 、or 、( )
#
# RULES='
# mode=ebpf and installed=ebpf   => ebpf
# js=ebpf-我的.js                 => ebpf, alpha
# tethering=on                   => alpha, ebpf
# always                         => vanilla
# '

# ----------------------------------------------------------------------------
# 下面这些默认值已经够用，需要时再写（不写就等于注释里的值）
# ----------------------------------------------------------------------------
# MODE_CORE_tun='vanilla'
# MODE_CORE_tproxy='vanilla'
# MODE_CORE_redirect='vanilla'
# MODE_CORE_mixed='vanilla'
# MODE_CORE_enhance='vanilla'
# MODE_CORE_unknown='vanilla'
#
# 新增自己的内核时，在这里写文件名（不写就是 core-<名字>）：
# CORE_mycore_FILE='core-mycore'
#
# DUMMY_IFACE='boxebpf0'     # eBPF 没开热点时的空转网卡
# CONFLICT_STOP='auto'       # 端口被占用时：auto 停掉 | log 只记 | off 不查
# STOP_PACKAGES=''           # 额外无条件停的包（空格分隔）
# EXTRA_PORTS=''             # 额外检查冲突的端口（空格分隔）
